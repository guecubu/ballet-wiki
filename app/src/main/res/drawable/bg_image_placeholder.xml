<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:opacity="opaque">

    <!-- Capa 1: Fondo de color -->
    <item android:alpha="0.5">
        <shape android:shape="rectangle">
            <solid android:color="@color/ballet_logo_bg" />
        </shape>
    </item>

    <!-- Capa 2: Icono centrado con tamaño y opacidad directa -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:alpha="0.5"
        android:drawable="@drawable/ic_ballet_logo"
        android:gravity="center" />

</layer-list>
