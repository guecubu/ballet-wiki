    <!-- Superficies Claras -->
    <!--    <color name="ballet_window_background">#FAF5F2</color>-->
    <color name="ballet_window_background">#F5EFEA</color>
    <color name="ballet_surface_container">#FFFFFF</color>
    <!--    <color name="ballet_surface_variant">#F5EBE6</color>-->
    <color name="ballet_surface_variant">#EFE3DD</color>
    <!--    <color name="ballet_surface_container_lowest">#CEC5BB</color>-->
    <color name="ballet_surface_container_lowest">#DCD2C8</color>
    <!--    <color name="ballet_surface_container_high">#EBDFED</color>-->
    <color name="ballet_surface_container_high">#E4D4E8</color>

    <!-- Tipografía -->
    <color name="ballet_text_high_emphasis">#1D171B</color>         <!-- Mulberry oscuro -->
    <color name="ballet_text_medium_emphasis">#594F55</color>       <!-- Ciruela medio -->
    <color name="ballet_text_on_accent">#FFFFFF</color>            <!-- Blanco puro sobre color -->
    <color name="ballet_text_disabled">#9E949A</color>
    <color name="ballet_text_on_accent_dark">#52434f</color>

    <!-- Familia Rosa Ballet / Frambuesa -->
    <color name="ballet_rose_accent">#B84D65</color>                <!-- Frambuesa saturado -->
    <color name="ballet_rose_highlight">#E8A5B2</color>
    <color name="ballet_rose_container">#FCECEE</color>             <!-- Rosa pastel empolvado -->

    <!-- Familia Oro / Bronce -->
    <color name="ballet_gold_primary">#8A5920</color>               <!-- Bronce calibrado claro -->
    <color name="ballet_gold_container">#FAEDE0</color>
    <color name="ballet_gold_light">#F5D6B3</color>

    <!-- Bordes físicos -->
    <color name="ballet_stroke_outline">#D8C7BD</color>

    <!-- Scrim (Tu calibración validada al 30%) -->
    <!--    <color name="ballet_scrim_gradient_center">#4DFCEBED</color>-->
    <color name="ballet_scrim_gradient_center">#4DF69B38</color>
    <!--    <color name="ballet_scrim_gradient_center">#99FAEDE0</color>-->
    <color name="ballet_scrim_gradient_end">#FFFFFF</color>
    <color name="ballet_scrim_gradient_center_detail">#66F0A34A</color>
    <color name="ballet_scrim_gradient_end_detail">#3B2332</color>


    <!-- ============================================================== -->
    <!-- CAPA 2: TOKENS SEMÁNTICOS DE COMPONENTE (SÓLO REFERENCIAS @)   -->
    <!-- MODO CLARO: Resuelven a la paleta audaz (Frambuesa & Blanco)   -->
    <!-- ============================================================== -->
    <!-- Chips de Estilo Coreográfico -->
    <color name="ballet_chip_bg_active">@color/ballet_rose_accent</color>
    <color name="ballet_chip_text_active">@color/ballet_text_on_accent</color>
    <color name="ballet_chip_stroke_active">@color/ballet_rose_accent</color>
    <color name="ballet_chip_bg_inactive">@color/ballet_surface_container</color>
    <color name="ballet_chip_text_inactive">@color/ballet_text_high_emphasis</color>
    <color name="ballet_chip_stroke_inactive">@color/ballet_stroke_outline</color>

    <!-- Badge de Época / Coreógrafo (sobre foto) -->
    <color name="ballet_badge_era_bg">@color/ballet_rose_container</color>
    <color name="ballet_badge_era_text">@color/ballet_rose_accent</color>
    <color name="ballet_badge_era_stroke">@color/ballet_stroke_outline</color>

    <!-- Acentos de Interacción en Tarjeta ("4 Actos →", Lupa, Bookmark) -->
    <color name="ballet_card_accent_action">@color/ballet_rose_accent</color>
    <color name="ballet_search_icon_tint">@color/ballet_rose_accent</color>
    <color name="ballet_search_bg">@color/ballet_surface_container</color>
    <color name="ballet_search_stroke">@color/ballet_stroke_outline</color>

    <!-- Barra de Navegación Inferior (BottomNavigationView) -->
    <color name="ballet_bottom_nav_bg">@color/ballet_surface_container</color>
    <color name="ballet_bottom_nav_item_active">@color/ballet_text_high_emphasis</color>
    <color name="ballet_bottom_nav_item_inactive">@color/ballet_text_medium_emphasis</color>
    <color name="ballet_bottom_nav_indicator">@color/ballet_rose_highlight</color>         <!-- Texto
    oscuro definido -->

    <!-- Chips Flotantes -->
    <color name="ballet_floating_chip_rose">@color/ballet_rose_accent</color>
    <color name="ballet_floating_chip_rose_text">@color/ballet_text_on_accent</color>
    <color name="ballet_floating_chip_light">@color/ballet_surface_container</color>
    <color name="ballet_floating_chip_light_text">@color/ballet_text_high_emphasis</color>
    <color name="ballet_floating_chip_rose_light">@color/ballet_rose_container</color>
    <color name="ballet_floating_chip_rose_light_text">@color/ballet_rose_accent</color>
    <color name="ballet_floating_chip_purple_light">@color/ballet_surface_container_high</color>
    <color name="ballet_floating_chip_purple_light_text">@color/ballet_text_on_accent_dark</color>
    <color name="ballet_floating_chip_gold">@color/ballet_gold_container</color>
    <color name="ballet_floating_chip_gold_text">@color/ballet_gold_primary</color>


    <!-- Logo Tokens (Modo Claro) -->
    <!-- Contenedor -->
    <color name="ballet_logo_bg">#F5EFEA</color>
    <color name="ballet_logo_stroke">@color/ballet_logo_silhouette</color>

    <!-- Silueta (Mulberry de alto contraste) -->
    <color name="ballet_logo_silhouette">#241722</color>

    <!-- Tutú -->
    <color name="ballet_logo_tutu_start">#F7AAB9</color>
    <color name="ballet_logo_tutu_mid">#DB667F</color>
    <color name="ballet_logo_tutu_end">#AD3752</color>

    <!-- Páginas del Libro (con canal alfa integrado en el hex #AARRGGBB) -->
    <!-- 45% alfa de #F7AAB9 = #73F7AAB9 -->
    <color name="ballet_logo_page_top">#DAF7AAB9</color>
    <!-- 60% alfa de #C58B58 = #99C58B58 -->
    <color name="ballet_logo_page_mid">#99C58B58</color>
    <!-- Base sólida: Mulberry bronce -->
    <color name="ballet_logo_page_base_start">#8C5C2E</color>
    <color name="ballet_logo_page_base_end">#3B2332</color>

    <!-- Cintas de zapatillas y detalles -->
    <color name="ballet_logo_highlights">#AD3752</color>
