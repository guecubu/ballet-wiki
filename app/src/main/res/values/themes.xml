<resources>

    <style name="Widget.App.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@android:color/transparent</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.Theme.BalletWiki" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <!-- Window & Surface Backgrounds -->
        <item name="android:windowBackground">@color/ballet_window_background</item>
        <item name="colorSurface">@color/ballet_surface_container</item>
        <item name="colorSurfaceVariant">@color/ballet_surface_variant</item>

        <!-- Primary Accent: Gold -->
        <item name="colorPrimary">@color/ballet_gold_primary</item>
        <item name="colorOnPrimary">@color/ballet_window_background</item>
        <item name="colorPrimaryContainer">@color/ballet_gold_container</item>
        <item name="colorOnPrimaryContainer">@color/ballet_gold_primary</item>

        <!-- Secondary Accent: Ballet Rose -->
        <item name="colorSecondary">@color/ballet_rose_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/ballet_rose_container</item>
        <item name="colorOnSecondaryContainer">@color/ballet_rose_accent</item>

        <!-- Outlines & Dividers -->
        <item name="colorOutline">@color/ballet_stroke_outline</item>

        <item name="materialCardViewStyle">@style/Widget.App.MaterialCardView</item>
    </style>

    <!-- En el estilo de tu aplicación (Theme.BalletWiki o similar) o en un estilo de BottomNav -->
    <style name="Widget.Ballet.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Ballet.BottomNav.Indicator</item>
    </style>

    <style name="Widget.Ballet.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- Apunta al token semántico: en claro será rosa suave, en oscuro será ámbar/oro oscuro -->
        <item name="android:color">@color/ballet_bottom_nav_indicator</item>
    </style>

    <!-- Estilo sutil y estilizado para los Chips de Estilo Coreográfico -->
    <style name="Widget.Ballet.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/ballet_chip_stroke_selector</item>
        <item name="chipBackgroundColor">@color/ballet_chip_background_selector</item>
        <item name="android:textColor">@color/ballet_chip_text_selector</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="checkedIconEnabled">false</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Animation.Ballet.ZoomDialog" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Theme.Ballet.ZoomDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Ballet.ZoomDialog</item>
    </style>

    <style name="Widget.Ballet.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="elevationOverlayEnabled">false</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Theme.BalletWiki" parent="Base.Theme.BalletWiki" />
</resources>
