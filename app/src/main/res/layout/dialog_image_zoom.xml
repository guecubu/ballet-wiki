<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F2121113">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/photoViewZoom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/btnCloseZoom"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="64dp"
        android:background="@drawable/bg_badge_era"
        android:contentDescription="@string/close"
        android:padding="2dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close"
        app:tint="@color/ballet_badge_era_text" />

    <TextView
        android:id="@+id/tvPhotoCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginTop="68dp"
        android:background="#66000000"
        android:letterSpacing="0.04"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        tools:text="© Johan Persson" />

</FrameLayout>
