<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F2121113">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/photoViewZoom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/btnCloseZoom"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="64dp"
        android:background="@drawable/bg_badge_era"
        android:contentDescription="@string/close"
        android:padding="2dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close"
        app:tint="@color/ballet_badge_era_text" />

    <LinearLayout
        android:id="@+id/layoutPhotoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_zoom_attribution"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvZoomTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Swan Lake, Act II" />

        <TextView
            android:id="@+id/tvZoomCreator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            tools:text="Creator: Edgar Degas" />

        <TextView
            android:id="@+id/tvZoomProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            tools:text="Provider: Europeana / Victoria and Albert Museum" />

        <TextView
            android:id="@+id/tvZoomLicense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            tools:text="Rights: Public Domain" />

        <TextView
            android:id="@+id/tvPhotoCredit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="© Johan Persson" />
    </LinearLayout>

</FrameLayout>
