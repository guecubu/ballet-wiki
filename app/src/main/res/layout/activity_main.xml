<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/workTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                tools:text="Swan Lake" />

            <TextView
                android:id="@+id/workDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="Ballet by Pyotr Ilyich Tchaikovsky" />

            <TextView
                android:id="@+id/composerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/composer_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/composerValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Pyotr Ilyich Tchaikovsky" />

            <TextView
                android:id="@+id/aliasesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/titles_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aliasesValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="El lago de los cisnes · Le Lac des cygnes" />

            <TextView
                android:id="@+id/workStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                tools:text="Datos guardados localmente" />

            <TextView
                android:id="@+id/sourceLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autoLink="web"
                android:text="@string/wikidata_source" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>