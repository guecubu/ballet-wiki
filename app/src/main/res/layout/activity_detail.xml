<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ballet_surface_container"
    android:fitsSystemWindows="true">

    <!-- ============================================================== -->
    <!-- 1. APPBARLAYOUT: CABECERA PARALLAX                             -->
    <!-- ============================================================== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ballet_surface_container">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:contentScrim="@color/ballet_surface_container"
            app:layout_scrollFlags="scroll|snapMargins|exitUntilCollapsed"
            app:statusBarScrim="@color/ballet_surface_container">

            <!-- CONTENEDOR PARALLAX: Fotografía a sangre + Scrim + Badges -->
            <FrameLayout
                android:id="@+id/heroParallaxContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.6">

                <!-- Fotografía de escena a sangre -->
                <ImageView
                    android:id="@+id/ivHeroCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="48dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <!-- Scrim inferior graduado -->
                <View
                    android:id="@+id/viewHeroScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/scrim_card_bottom" />

                <!-- Crédito de fotografía flotante -->
                <!--                <TextView-->
                <!--                    android:id="@+id/tvPhotoCredit"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_gravity="top|end"-->
                <!--                    android:layout_margin="16dp"-->
                <!--                    android:layout_marginTop="68dp"-->
                <!--                    android:background="#66000000"-->
                <!--                    android:letterSpacing="0.04"-->
                <!--                    android:paddingHorizontal="8dp"-->
                <!--                    android:paddingVertical="3dp"-->
                <!--                    android:textColor="#E6FFFFFF"-->
                <!--                    android:textSize="11sp"-->
                <!--                    tools:text="© Johan Persson" />-->

                <!-- Badges flotantes en la base de la fotografía -->
                <LinearLayout
                    android:id="@+id/layoutHeroBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="64dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Badge de Estilo / Género -->
                    <TextView
                        android:id="@+id/tvBadgeStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_rose"
                        android:gravity="center"
                        android:letterSpacing="0.02"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/ballet_floating_chip_rose_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Contemporary" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <!-- Badge de Número de Actos -->
                    <TextView
                        android:id="@+id/tvBadgeActs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_light"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/ballet_floating_chip_light_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="3 Actos" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <!-- Badge de Época -->
                    <TextView
                        android:id="@+id/tvBadgeEpoch"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_era"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/ballet_badge_era_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Romantic" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <!-- Badge de Dificultad -->
                    <TextView
                        android:id="@+id/tvBadgeDifficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_gold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/ballet_floating_chip_gold_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Advanced" />

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ============================================================== -->
    <!-- 2. CONTENIDO DESPLAZABLE QUE MONTA SOBRE LA FOTO (SHEET)       -->
    <!-- ============================================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-302dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA EDITORIAL BLANCA (SHEET DESLIZANTE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditorialSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/ballet_surface_container"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:strokeColor="@color/ballet_stroke_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="24dp">

                    <!-- Título Principal en Bodoni/Serifa Editorial -->
                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bodoni_moda"
                        android:letterSpacing="0.01"
                        android:textAppearance="?attr/textAppearanceHeadlineMediumEmphasized"
                        android:textColor="@color/ballet_text_high_emphasis"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="Lago de los cisnes" />

                    <!-- Título Original: sin paréntesis, cursiva legible -->
                    <TextView
                        android:id="@+id/tvOriginalTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/ballet_text_medium_emphasis"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:visibility="gone"
                        tools:text="The Winter's Tale" />

                    <!-- Autores / Creadores -->
                    <TextView
                        android:id="@+id/tvCreators"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/ballet_text_high_emphasis"
                        android:textSize="13sp"
                        tools:text="Joby Talbot • Christopher Wheeldon" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="4dp" />

                    <!-- CAJA MODULAR 3: ESTRENO (Lugar y fecha) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/boxPremiere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_box_premiere"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:id="@+id/ivIconPremiere"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/logo_content_description"
                            android:scaleX="-1"
                            android:src="@drawable/twotone_theater_comedy_24"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/ballet_gold_primary" />

                        <TextView
                            android:id="@+id/tvLabelPremiere"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.04"
                            android:textColor="@color/ballet_text_high_emphasis"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginStart="12dp"
                            android:textAllCaps="true"
                            app:layout_constraintBottom_toTopOf="@id/tvValuePremiere"
                            app:layout_constraintStart_toEndOf="@+id/ivIconPremiere"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Estreno • 2014" />

                        <TextView
                            android:id="@+id/tvValuePremiere"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/ballet_text_medium_emphasis"
                            android:layout_marginStart="12dp"
                            android:textSize="14sp"
                            android:textStyle="italic"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/ivIconPremiere"
                            app:layout_constraintTop_toBottomOf="@+id/tvLabelPremiere"
                            tools:text="Royal Opera House, Covent Garden, London" />

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp" />

                    <!-- CAJA MODULAR 2: TRADICIÓN / ESCUELA COREOGRÁFICA -->
                    <LinearLayout
                        android:id="@+id/rowTraditionSchools"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- 1. COLUMNA IZQUIERDA: TRADICIÓN (Rosa Empolvado) -->
                        <LinearLayout
                            android:id="@+id/boxTraditionCol"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_box_tradition"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- Cabecera de Columna -->
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@string/logo_content_description"
                                    android:src="@drawable/ic_tradition"
                                    app:tint="@color/ballet_rose_accent" />

                                <TextView
                                    android:id="@+id/tvLabelTradition"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:letterSpacing="0.08"
                                    android:text="@string/tradition"
                                    android:textAllCaps="true"
                                    android:textColor="@color/ballet_rose_accent"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Contenedor dinámico para items de Tradición -->
                            <LinearLayout
                                android:id="@+id/layoutTraditionItems"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />

                        </LinearLayout>

                        <!-- 2. COLUMNA DERECHA: ESCUELAS (Marfil / Dorado) -->
                        <LinearLayout
                            android:id="@+id/boxSchoolsCol"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_box_schools"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <!-- Cabecera de Columna -->
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:contentDescription="@string/logo_content_description"
                                    android:src="@drawable/ic_school"
                                    app:tint="@color/ballet_gold_primary" />

                                <!-- Cabecera de Columna -->
                                <TextView
                                    android:id="@+id/tvLabelSchools"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:letterSpacing="0.08"
                                    android:text="@string/school"
                                    android:textAllCaps="true"
                                    android:textColor="@color/ballet_gold_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                            <!-- Contenedor dinámico para items de Escuelas -->
                            <LinearLayout
                                android:id="@+id/layoutSchoolsItems"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="vertical" />

                        </LinearLayout>

                    </LinearLayout>
                    <!-- CAJA MODULAR 1: GÉNERO (Rosa empolvado) -->
                    <LinearLayout
                        android:id="@+id/boxGenre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_box_genre"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:id="@+id/tvLabelGenre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/genre"
                            android:textColor="@color/ballet_floating_chip_purple_light_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvValueGenre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/ballet_floating_chip_purple_light_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Narrative • Dramatic • Full-length" />

                    </LinearLayout>

                    <!-- Botón Notas Personales -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenNotes"
                        style="@style/Widget.Material3.Button.ElevatedButton"
                        android:stateListAnimator="@null"
                        android:text="@string/btn_notes"
                        android:textColor="@color/ballet_text_on_accent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:translationZ="4dp"
                        app:backgroundTint="@color/ballet_text_on_accent_dark"
                        app:elevation="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SUBSEQUENT SECTIONS (Synopsis, History, Characters, Open Opus, Europeana, etc.) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="48dp">

                <!-- Synopsis section -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/ballet_surface_container"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ballet_stroke_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/section_synopsis"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/ballet_rose_accent"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailSynopsis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/ballet_text_high_emphasis"
                            tools:text="Synopsis de la obra..." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- History and evolution -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/ballet_gold_container"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/ballet_chip_stroke_selector"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/section_history"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/ballet_gold_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/ballet_text_high_emphasis"
                            tools:text="Historia y evolución..." />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Characters Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/ballet_surface_container"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ballet_stroke_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/section_characters"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/ballet_text_on_accent_dark"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupCharacters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="6dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Key Variations Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/ballet_floating_chip_purple_light"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ballet_floating_chip_purple_light_text"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/section_variations"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/ballet_gold_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailVariations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/ballet_text_high_emphasis"
                            tools:text="• Grand pas de deux\n• 32 Fouettés" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Extra: Open Opus Composer Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/groupComposer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/ballet_surface_container"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ballet_stroke_outline"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="18dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivComposer"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:contentDescription="@string/logo_content_description"
                            android:scaleType="centerCrop"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            app:strokeColor="@color/ballet_rose_accent"
                            app:strokeWidth="2dp"
                            tools:src="@drawable/bg_image_placeholder" />

                        <TextView
                            android:id="@+id/tvOpenOpusHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/ballet_gold_primary"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/ivComposer"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Pyotr Ilyich Tchaikovsky" />

                        <TextView
                            android:id="@+id/tvOpenOpusInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/ballet_text_high_emphasis"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/ivComposer"
                            app:layout_constraintTop_toBottomOf="@+id/tvOpenOpusHeader"
                            tools:text="1840 - 1893" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Extra: Europeana Multimedia Modules -->
                <TextView
                    android:id="@+id/tvEuropeanaHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/section_europeana"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Module 1: Image Gallery -->
                <TextView
                    android:id="@+id/tvImageGalleryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/section_image_gallery"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMediaGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_media_gallery" />

                <!-- Module 2: Audio Records -->
                <LinearLayout
                    android:id="@+id/layoutAudioSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAudioHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_audio_recordings"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAudioPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/ballet_surface_container"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/ballet_stroke_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvAudioCurrentTrack"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="@color/ballet_text_high_emphasis"
                                android:textStyle="bold"
                                tools:text="Pista 1 de 3 — Recording title" />

                            <TextView
                                android:id="@+id/tvAudioProvider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/ballet_gold_primary"
                                tools:text="National Library of France" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btnAudioPrev"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/app_name"
                                    android:src="@android:drawable/ic_media_previous"
                                    app:tint="@color/ballet_gold_primary" />

                                <ImageButton
                                    android:id="@+id/btnAudioPlayPause"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginHorizontal="16dp"
                                    android:background="@drawable/bg_badge_era"
                                    android:contentDescription="@string/app_name"
                                    android:padding="8dp"
                                    android:scaleType="fitCenter"
                                    android:src="@android:drawable/ic_media_play"
                                    app:tint="@color/ballet_gold_primary" />

                                <ImageButton
                                    android:id="@+id/btnAudioNext"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/app_name"
                                    android:src="@android:drawable/ic_media_next"
                                    app:tint="@color/ballet_gold_primary" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Module 3: Video Records -->
                <LinearLayout
                    android:id="@+id/layoutVideoSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvVideoHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_video_recordings"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- LOADING & ERROR OVERLAYS -->
    <ProgressBar
        android:id="@+id/detailProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/detailLayoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_loading"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry" />

    </LinearLayout>
    <!-- Barra de navegación anclada con fondo sólido (Pinned Toolbar) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/ballet_surface_container"
        android:elevation="12dp"
        app:navigationIcon="?attr/homeAsUpIndicator">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/ballet_text_high_emphasis"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDetailFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_favorite_border" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
