<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================== -->
    <!-- CAPA 1: PALETA PRIMITIVA / IDENTIDAD DE MARCA (VALORES HEX)    -->
    <!-- ============================================================== -->
    <!-- Superficies Oscuras (Obsidiana Teatral) -->
    <color name="ballet_window_background">#121113</color>
    <color name="ballet_surface_container">#1C1A1E</color>
    <color name="ballet_surface_variant">#2A262D</color>
    <color name="ballet_surface_container_lowest">#121114</color>

    <!-- Tipografía -->
    <color name="ballet_text_high_emphasis">#F8F3ED</color>         <!-- Perla / Marfil -->
    <color name="ballet_text_medium_emphasis">#B8B0B5</color>       <!-- Plata medio -->
    <color name="ballet_text_on_accent">#121113</color>
    <color name="ballet_text_disabled">#686066</color>

    <!-- Familia Oro Primario / Bronce -->
    <color name="ballet_gold_primary">#E2A96B</color>               <!-- Oro primario luminoso -->
    <color name="ballet_gold_light">#FCE1BE</color>
    <color name="ballet_gold_container">#3D2D1B</color>             <!-- Contenedor ámbar cálido -->

    <!-- Familia Rosa en Oscuro -->
    <color name="ballet_rose_accent">#E88096</color>
    <color name="ballet_rose_highlight">#FFCAD4</color>
    <color name="ballet_rose_container">#421D26</color>

    <!-- Contornos físicos -->
    <color name="ballet_stroke_outline">#38323C</color>

    <!-- Scrim Oscuro Original -->
    <color name="ballet_scrim_gradient_center">#661C1A1E</color>
    <color name="ballet_scrim_gradient_end">#1C1A1E</color>

    <!-- ============================================================== -->
    <!-- CAPA 2: TOKENS SEMÁNTICOS DE COMPONENTE (SÓLO REFERENCIAS @)   -->
    <!-- MODO OSCURO: Resuelven a la paleta dorada y obsidiana original -->
    <!-- ============================================================== -->
    <!-- Chips de Estilo Coreográfico -->
    <color name="ballet_chip_bg_active">@color/ballet_gold_container</color>
    <color name="ballet_chip_text_active">@color/ballet_gold_primary</color>
    <color name="ballet_chip_stroke_active">@color/ballet_gold_primary</color>
    <color name="ballet_chip_bg_inactive">@color/ballet_surface_container</color>
    <color name="ballet_chip_text_inactive">@color/ballet_text_medium_emphasis</color>
    <color name="ballet_chip_stroke_inactive">@color/ballet_stroke_outline</color>

    <!-- Badge de Época / Coreógrafo (sobre foto) -->
    <color name="ballet_badge_era_bg">@color/ballet_surface_container</color>
    <color name="ballet_badge_era_text">@color/ballet_rose_accent</color>
    <color name="ballet_badge_era_stroke">@color/ballet_stroke_outline</color>

    <!-- Acentos de Interacción en Tarjeta ("4 Actos →", Lupa, Bookmark) -->
    <color name="ballet_card_accent_action">@color/ballet_gold_primary</color>
    <color name="ballet_search_icon_tint">@color/ballet_gold_primary</color>
    <color name="ballet_search_bg">@color/ballet_surface_variant</color>
    <color name="ballet_search_stroke">@color/ballet_stroke_outline</color>

    <!-- Barra de Navegación Inferior (BottomNavigationView) -->
    <color name="ballet_bottom_nav_bg">@color/ballet_surface_container</color>
    <color name="ballet_bottom_nav_item_active">@color/ballet_gold_primary</color>
    <color name="ballet_bottom_nav_item_inactive">@color/ballet_text_medium_emphasis</color>
    <color name="ballet_bottom_nav_indicator">@color/ballet_rose_container</color>

    <!-- Logo Tokens (Modo Oscuro) -->
    <!-- Contenedor (con 35% de alfa en el borde dorado: #59E2A96B) -->
    <color name="ballet_logo_bg">#121114</color>
    <color name="ballet_logo_stroke">#59E2A96B</color>

    <!-- Silueta (Oro de marca sobre obsidiana) -->
    <color name="ballet_logo_silhouette">#E2A96B</color>

    <!-- Tutú -->
    <color name="ballet_logo_tutu_start">#FFCAD4</color>
    <color name="ballet_logo_tutu_mid">#E88096</color>
    <color name="ballet_logo_tutu_end">#421D26</color>

    <!-- Páginas del Libro (con canal alfa integrado en el hex #AARRGGBB) -->
    <!-- 35% alfa de #E88096 = #59E88096 -->
    <color name="ballet_logo_page_top">#59E88096</color>
    <!-- 55% alfa de #E2A96B = #8CE2A96B -->
    <color name="ballet_logo_page_mid">#8CE2A96B</color>
    <!-- Base sólida: Bronce a negro cálido -->
    <color name="ballet_logo_page_base_start">#E2A96B</color>
    <color name="ballet_logo_page_base_end">#6E481D</color>

    <!-- Cintas de zapatillas y detalles -->
    <color name="ballet_logo_highlights">#FCE1BE</color>
</resources>
